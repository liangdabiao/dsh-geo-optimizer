{
  "name": "dsh-geo-optimizer",
  "version": "0.1.0",
  "description": "GEO 工具箱（生成式引擎优化）：3 个技能让 AI 回答问题时主动提到你——单页体检 / 全流程优化 / 完整服务流水线。纯技能零 API key。",
  "license": "MIT",
  "type": "module",
  "main": "src/host.js",
  "exports": {
    ".": "./src/host.js",
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "icon": "./icon.svg",
  "files": ["src", "dist", "lib", "skills", "locale/*.json", "cordis.patch.yml", "icon.svg", "README.md", "LICENSE"],
  "keywords": ["dsh-plugin", "deepseek-harness", "geo", "seo", "content"],
  "engines": { "node": "^22.19.0 || >=24.0.0", "dsh": ">=0.2.1-rc.2 <0.3.0" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true, "inject": [] }
  },
  "devDependencies": { "esbuild": "^0.25.10" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node test/lib.test.mjs",
    "selftest": "node scripts/selftest.mjs",
    "prepack": "npm run build"
  }
}
